# Copy to .env for local overrides (never commit .env)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=flydeer
MYSQL_USER=flydeer
MYSQL_PASSWORD=flydeer
MYSQL_ROOT_PASSWORD=root
REDIS_HOST=localhost
REDIS_PORT=6379
SERVER_PORT=8080

# JWT / frontend
# AUTH_JWT_SECRET=change-me-to-a-long-random-secret-key!!
# AUTH_FRONTEND_REDIRECT=http://localhost:5173/auth/callback

# SMS（Docker Compose 默认 SMS_MOCK_ENABLED=true，会覆盖此处）
# SMS_MOCK_ENABLED=false
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

# OAuth
# OAUTH_STATE_SECRET=change-me-oauth-state-hmac-secret!!
# OAUTH_GITEE_CLIENT_ID=
# OAUTH_GITEE_CLIENT_SECRET=
# OAUTH_GITEE_REDIRECT_URI=http://localhost:8080/api/v1/auth/gitee/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback
