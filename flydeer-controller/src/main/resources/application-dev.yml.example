# Dev profile template — migrated from .env.dev
# Copy to application-dev.yml (gitignored) and adjust:
#   cp flydeer-controller/src/main/resources/application-dev.yml.example \
#      flydeer-controller/src/main/resources/application-dev.yml

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/flydeer?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
    username: flydeer
    password: flydeer
  data:
    redis:
      host: localhost
      port: 6379
      password:

server:
  port: 8080

app:
  jwt:
    secret: change-me-to-a-long-random-secret-key!!
    access-token-ttl: 2h
    refresh-token-ttl: 90d
    refresh-cookie-name: refresh_token
    refresh-cookie-secure: false
    refresh-cookie-path: /api/v1/auth
    redirect-url: http://localhost:5173/oauth/callback
  id:
    start: 10000000
    step-min: 1
    step-max: 99
  sms:
    mock-enabled: true
    access-key-id:
    access-key-secret:
    sign-name:
    template-code:
    region: cn-shanghai
    endpoint: dypnsapi.aliyuncs.com
    country-code: "86"
  user:
    phone-hash-salt: change-me-phone-hash-salt!!
    # 管理员用户 ID 列表，用于 AuthRequiredLevel.ADMIN
    admin-ids: []
    ratelimit:
      sms-interval: 60s
      sms-daily-limit-per-phone: 20
      sms-daily-limit-per-ip: 50
      login-interval: 1s
  oauth:
    secret: change-me-oauth-state-hmac-secret!!
    timeout: 600000
    oauth:
      gitee:
        client-id: 3f9e74c4e6b4b68a1259bc1c0c30b334b37a7c1f1072f1149af62ef43143acec
        client-secret: 6ba48fc7cde9da0a453de81b79840d8dbdd5192e7ae41ef0cd4b7f8d3eb358f1
        redirect-uri: http://localhost:8080/api/v1/auth/gitee/callback
        authorize-url: https://gitee.com/oauth/authorize
        token-url: https://gitee.com/oauth/token
        user-url: https://gitee.com/api/v5/user
        scope: user_info
      github:
        client-id: Ov23linw1wfo2KnQMRTy
        client-secret: 9f8756a289567ffe5246912d4c88168627059ac4
        redirect-uri: http://localhost:8080/api/v1/auth/github/callback
        authorize-url: https://github.com/login/oauth/authorize
        token-url: https://github.com/login/oauth/access_token
        user-url: https://api.github.com/user
        scope: read:user
