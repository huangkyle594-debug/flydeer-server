# Docker Compose profile template — activated by SPRING_PROFILES_ACTIVE=docker
# Copy to application-docker.yml (gitignored) and fill real values:
#   cp flydeer-controller/src/main/resources/application-docker.yml.example \
#      flydeer-controller/src/main/resources/application-docker.yml

spring:
  datasource:
    mysql:
      url: jdbc:mysql://mysql:3306/flydeer?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
      username: flydeer
      password: flydeer
      driver-class-name: com.mysql.cj.jdbc.Driver
    postgres:
      url: jdbc:postgresql://postgres:5432/flydeer_graph
      username: flydeer
      password: flydeer
      driver-class-name: org.postgresql.Driver
  data:
    redis:
      host: redis
      port: 6379
      password:
  docker:
    compose:
      enabled: false

server:
  port: 8080
  tomcat:
    max-http-form-post-size: 10MB
    max-swallow-size: 10MB

app:
  jwt:
    secret: change-me-to-a-long-random-secret-key!!
    access-token-ttl: 2h
    refresh-token-ttl: 90d
    refresh-cookie-name: refresh_token
    refresh-cookie-secure: false
    refresh-cookie-path: /api/v1/auth
    redirect-url: http://localhost/oauth/callback
  id:
    start: 10000000
    step-min: 1
    step-max: 99
  sms:
    mock-enabled: false
    access-key-id:
    access-key-secret:
    sign-name:
    template-code:
    region: cn-shanghai
    endpoint: dypnsapi.aliyuncs.com
    country-code: "86"
    code-length: 6
    valid-time-seconds: 300
    send-interval-seconds: 60
    template-expire-minutes: 5
  user:
    phone-hash-salt: change-me-phone-hash-salt!!
    admin-ids: []
    ratelimit:
      sms-interval: 60s
      sms-daily-limit-per-phone: 20
      sms-daily-limit-per-ip: 50
      login-interval: 1s
  oauth:
    secret: change-me-oauth-state-hmac-secret!!
    timeout: 600000
    oauth:
      gitee:
        client-id:
        client-secret:
        redirect-uri: http://127.0.0.1/api/v1/auth/gitee/callback
        authorize-url: https://gitee.com/oauth/authorize
        token-url: https://gitee.com/oauth/token
        user-url: https://gitee.com/api/v5/user
        scope: user_info
      github:
        client-id:
        client-secret:
        redirect-uri: http://127.0.0.1/api/v1/auth/github/callback
        authorize-url: https://github.com/login/oauth/authorize
        token-url: https://github.com/login/oauth/access_token
        user-url: https://api.github.com/user
        scope: read:user
